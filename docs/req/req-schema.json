{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research-desk.local/req-schema.json",
  "title": "Research Desk requirements registry",
  "description": "Schema for docs/req/requirements.yaml: the top-level requirements registry with schema_version, product and a requirements list. Each requirement declares a measurable fit criterion, source, components and acceptance tests. This is the schema of the real registry, not of an evidence manifest.",
  "type": "object",
  "required": ["schema_version", "product", "requirements"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/requirement" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "requirement": {
      "type": "object",
      "required": ["id", "type", "statement", "priority", "fit", "source", "components", "tests"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "type": {
          "type": "string",
          "enum": ["functional", "performance", "security", "quality", "cost", "invariant", "governance"]
        },
        "statement": { "type": "string", "minLength": 5 },
        "priority": { "type": "string", "enum": ["Must", "Should", "Inherited"] },
        "fit": { "$ref": "#/definitions/fit" },
        "source": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "components": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(AT-[0-9]{2}|upstream-regression)$" }
        }
      }
    },
    "fit": {
      "type": "object",
      "required": ["metric", "operator", "threshold", "verification"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "enum": ["==", "!=", "<", "<=", ">", ">="] },
        "threshold": { "type": ["number", "string"], "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    }
  }
}
