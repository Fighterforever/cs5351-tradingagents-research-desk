{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "Gate 1 - tests approved before implementation",
      "Gate 2 - lint, types, deps and authority boundary",
      "Gate 3 - requirements schema and traceability",
      "Gate 4 - fixed semantic regression (offline)",
      "Gate 5 - full regression (tests + test/offline)",
      "Gate 6 - AI-use log required for code/prompt changes"
    ]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 1
  },
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "required_conversation_resolution": true
}
